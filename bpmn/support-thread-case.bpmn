<?xml version="1.0" encoding="UTF-8"?>
<!--
  support-thread-case: one Slack support thread = one case.

  Hand-written BPMN 2.0 for Camunda 8 (Zeebe). Mirrors a production Slack on-call bot:
  a thread tags the on-call group -> a journal row is opened -> we wait for "resolved"
  or "excluded" and nudge the on-call engineer on a schedule -> after resolution the
  on-call engineer fills a duty survey while the author gets a CSAT prompt -> a CSAT
  that never arrives lands in the Monday digest -> the case is closed and a summary is
  posted to a webhook via the Camunda REST connector.

  Process variables (set by the "thread-tagged" message):
    threadId   string  correlation key; one active case per thread
    channel    string
    author     string  thread author (gets the CSAT prompt)
    onCall     string  on-call engineer (gets reminders and the duty survey)
    text       string  first message of the thread (used for area classification)
    reminderDelays  list of ISO-8601 durations, optional, default ["P1D","P2D","P7D"]
                    (= reminders on day 1, day 3, day 10)
    csatTimeout     ISO-8601 duration, optional, default "P3D"
    webhookUrl      string, optional, default https://httpbin.org/post
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_SupportThreadCase"
                  targetNamespace="http://example.com/support-platform"
                  exporter="hand-written"
                  exporterVersion="1"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.10.0">

  <bpmn:message id="Message_ThreadTagged" name="thread-tagged">
    <bpmn:extensionElements>
      <!-- correlation key on the start message = idempotency: a second tag on the same
           thread does not open a second case while the first one is active -->
      <zeebe:subscription correlationKey="=threadId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ThreadResolved" name="thread-resolved">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=threadId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ThreadExcluded" name="thread-excluded">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=threadId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:process id="support-thread-case" name="Support thread case" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="v1" />
    </bpmn:extensionElements>

    <!-- ===== start ===== -->
    <bpmn:startEvent id="Start_ThreadTagged" name="On-call group tagged in a thread">
      <bpmn:outgoing>Flow_Start_Classify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start" messageRef="Message_ThreadTagged" />
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_ClassifyArea" name="Classify area (LLM or heuristic)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="classify-area" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=text" target="text" />
          <zeebe:output source="=area" target="area" />
          <zeebe:output source="=areaSource" target="areaSource" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_Open</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_OpenJournal" name="Open journal row">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="open-journal-row" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="=caseId" target="caseId" />
          <zeebe:output source="=openedAt" target="openedAt" />
          <!-- model-owned defaults; callers may override for demos and tests -->
          <zeebe:output source="=0" target="reminderIndex" />
          <zeebe:output source="=if reminderDelays = null then [&#34;P1D&#34;, &#34;P2D&#34;, &#34;P7D&#34;] else reminderDelays" target="reminderDelays" />
          <zeebe:output source="=if csatTimeout = null then &#34;P3D&#34; else csatTimeout" target="csatTimeout" />
          <zeebe:output source="=if webhookUrl = null then &#34;https://httpbin.org/post&#34; else webhookUrl" target="webhookUrl" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Classify_Open</bpmn:incoming>
      <bpmn:outgoing>Flow_Open_Wait</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ===== wait for a signal from Slack, with scheduled reminders ===== -->
    <bpmn:eventBasedGateway id="Gateway_WaitSignal" name="Wait for signal">
      <bpmn:incoming>Flow_Open_Wait</bpmn:incoming>
      <bpmn:incoming>Flow_MoreReminders_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Resolved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Excluded</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_Resolved" name="Resolved (✅ or Jira ticket)">
      <bpmn:incoming>Flow_Wait_Resolved</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolved_Fork</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Resolved" messageRef="Message_ThreadResolved" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_ReminderTimer" name="Next reminder due">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Decide</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=reminderDelays[reminderIndex + 1]</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_Excluded" name="Excluded by on-call (❌)">
      <bpmn:incoming>Flow_Wait_Excluded</bpmn:incoming>
      <bpmn:outgoing>Flow_Excluded_Reject</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Excluded" messageRef="Message_ThreadExcluded" />
    </bpmn:intermediateCatchEvent>

    <!-- excluded branch -->
    <bpmn:serviceTask id="Task_MarkRejected" name="Mark journal row rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-case-rejected" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Excluded_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Excluded" name="Not a support case">
      <bpmn:incoming>Flow_Reject_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- reminder branch -->
    <bpmn:businessRuleTask id="Task_DecideEscalation" name="Decide escalation level">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="escalation-level" resultVariable="escalation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_Decide_Nudge</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="Task_Nudge" name="Nudge on-call engineer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="nudge-on-call" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=escalation" target="escalation" />
          <zeebe:output source="=reminderIndex + 1" target="reminderIndex" />
          <zeebe:output source="=lastReminderAt" target="lastReminderAt" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decide_Nudge</bpmn:incoming>
      <bpmn:outgoing>Flow_Nudge_More</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_MoreReminders" name="More reminders scheduled?" default="Flow_MoreReminders_No">
      <bpmn:incoming>Flow_Nudge_More</bpmn:incoming>
      <bpmn:outgoing>Flow_MoreReminders_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_MoreReminders_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_MarkStale" name="Mark case stale for weekly report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-case-stale" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MoreReminders_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Stale_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Stale" name="Stale, escalated to lead">
      <bpmn:incoming>Flow_Stale_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== resolved: duty survey and CSAT in parallel ===== -->
    <bpmn:parallelGateway id="Gateway_Fork">
      <bpmn:incoming>Flow_Resolved_Fork</bpmn:incoming>
      <bpmn:outgoing>Flow_Fork_Survey</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fork_Csat</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_DutySurvey" name="Fill duty survey">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="duty-survey" />
        <zeebe:assignmentDefinition candidateGroups="on-call" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Survey</bpmn:incoming>
      <bpmn:outgoing>Flow_Survey_Join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Csat" name="Rate the support you got (CSAT)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="csat" />
        <zeebe:assignmentDefinition candidateGroups="thread-authors" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fork_Csat</bpmn:incoming>
      <bpmn:outgoing>Flow_Csat_Merge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_CsatTimeout" name="No answer in time" attachedToRef="Task_Csat" cancelActivity="true">
      <bpmn:outgoing>Flow_Timeout_Digest</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_CsatTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=csatTimeout</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Digest" name="Add to Monday CSAT digest">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="add-to-monday-digest" retries="3" />
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;timeout&#34;" target="csatRating" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeout_Digest</bpmn:incoming>
      <bpmn:outgoing>Flow_Digest_Merge</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- The CSAT branch ends in exactly one of two ways (answered or timed out), so merge
         them with an exclusive gateway BEFORE the parallel join. A parallel join waits for a
         token on every incoming flow; wiring both ends into it directly deadlocks forever.
         Found the hard way on the first demo run. -->
    <bpmn:exclusiveGateway id="Gateway_CsatDone" name="CSAT answered or timed out">
      <bpmn:incoming>Flow_Csat_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Digest_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_Survey_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Merge_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Close</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_CloseCase" name="Close case in journal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Close</bpmn:incoming>
      <bpmn:outgoing>Flow_Close_Webhook</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Camunda REST connector (runs in the Connectors runtime, no custom code) -->
    <bpmn:serviceTask id="Task_PostWebhook" name="Post case summary to webhook (REST connector)"
                      zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=webhookUrl" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="={caseId: caseId, threadId: threadId, channel: channel, area: area, csat: csatRating, survey: {area: surveyArea, type: surveyType, outcome: surveyOutcome, solver: surveySolver, couldSolveAlone: surveyCouldSolveAlone}}" target="body" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={webhookStatus: response.status}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Close_Webhook</bpmn:incoming>
      <bpmn:outgoing>Flow_Webhook_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Closed" name="Case closed">
      <bpmn:incoming>Flow_Webhook_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===== sequence flows ===== -->
    <bpmn:sequenceFlow id="Flow_Start_Classify" sourceRef="Start_ThreadTagged" targetRef="Task_ClassifyArea" />
    <bpmn:sequenceFlow id="Flow_Classify_Open" sourceRef="Task_ClassifyArea" targetRef="Task_OpenJournal" />
    <bpmn:sequenceFlow id="Flow_Open_Wait" sourceRef="Task_OpenJournal" targetRef="Gateway_WaitSignal" />
    <bpmn:sequenceFlow id="Flow_Wait_Resolved" sourceRef="Gateway_WaitSignal" targetRef="Event_Resolved" />
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="Gateway_WaitSignal" targetRef="Event_ReminderTimer" />
    <bpmn:sequenceFlow id="Flow_Wait_Excluded" sourceRef="Gateway_WaitSignal" targetRef="Event_Excluded" />
    <bpmn:sequenceFlow id="Flow_Excluded_Reject" sourceRef="Event_Excluded" targetRef="Task_MarkRejected" />
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="Task_MarkRejected" targetRef="End_Excluded" />
    <bpmn:sequenceFlow id="Flow_Timer_Decide" sourceRef="Event_ReminderTimer" targetRef="Task_DecideEscalation" />
    <bpmn:sequenceFlow id="Flow_Decide_Nudge" sourceRef="Task_DecideEscalation" targetRef="Task_Nudge" />
    <bpmn:sequenceFlow id="Flow_Nudge_More" sourceRef="Task_Nudge" targetRef="Gateway_MoreReminders" />
    <bpmn:sequenceFlow id="Flow_MoreReminders_Yes" name="yes" sourceRef="Gateway_MoreReminders" targetRef="Gateway_WaitSignal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reminderIndex &lt; count(reminderDelays)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MoreReminders_No" name="no" sourceRef="Gateway_MoreReminders" targetRef="Task_MarkStale" />
    <bpmn:sequenceFlow id="Flow_Stale_End" sourceRef="Task_MarkStale" targetRef="End_Stale" />
    <bpmn:sequenceFlow id="Flow_Resolved_Fork" sourceRef="Event_Resolved" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Survey" sourceRef="Gateway_Fork" targetRef="Task_DutySurvey" />
    <bpmn:sequenceFlow id="Flow_Fork_Csat" sourceRef="Gateway_Fork" targetRef="Task_Csat" />
    <bpmn:sequenceFlow id="Flow_Survey_Join" sourceRef="Task_DutySurvey" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Csat_Merge" sourceRef="Task_Csat" targetRef="Gateway_CsatDone" />
    <bpmn:sequenceFlow id="Flow_Timeout_Digest" sourceRef="Boundary_CsatTimeout" targetRef="Task_Digest" />
    <bpmn:sequenceFlow id="Flow_Digest_Merge" sourceRef="Task_Digest" targetRef="Gateway_CsatDone" />
    <bpmn:sequenceFlow id="Flow_Merge_Join" sourceRef="Gateway_CsatDone" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Close" sourceRef="Gateway_Join" targetRef="Task_CloseCase" />
    <bpmn:sequenceFlow id="Flow_Close_Webhook" sourceRef="Task_CloseCase" targetRef="Task_PostWebhook" />
    <bpmn:sequenceFlow id="Flow_Webhook_End" sourceRef="Task_PostWebhook" targetRef="End_Closed" />
  </bpmn:process>

  <!-- ===== diagram ===== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="support-thread-case">
      <bpmndi:BPMNShape id="Shape_Start_ThreadTagged" bpmnElement="Start_ThreadTagged">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="128" y="225" width="85" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ClassifyArea" bpmnElement="Task_ClassifyArea">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_OpenJournal" bpmnElement="Task_OpenJournal">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_WaitSignal" bpmnElement="Gateway_WaitSignal">
        <dc:Bounds x="545" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="533" y="145" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_Resolved" bpmnElement="Event_Resolved">
        <dc:Bounds x="652" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="630" y="145" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_ReminderTimer" bpmnElement="Event_ReminderTimer">
        <dc:Bounds x="652" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="485" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_Excluded" bpmnElement="Event_Excluded">
        <dc:Bounds x="652" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="625" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MarkRejected" bpmnElement="Task_MarkRejected">
        <dc:Bounds x="740" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Excluded" bpmnElement="End_Excluded">
        <dc:Bounds x="892" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="866" y="625" width="88" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DecideEscalation" bpmnElement="Task_DecideEscalation">
        <dc:Bounds x="740" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Nudge" bpmnElement="Task_Nudge">
        <dc:Bounds x="890" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_MoreReminders" bpmnElement="Gateway_MoreReminders" isMarkerVisible="true">
        <dc:Bounds x="1045" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="398" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_MarkStale" bpmnElement="Task_MarkStale">
        <dc:Bounds x="1140" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Stale" bpmnElement="End_Stale">
        <dc:Bounds x="1292" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1268" y="485" width="85" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Fork" bpmnElement="Gateway_Fork">
        <dc:Bounds x="745" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DutySurvey" bpmnElement="Task_DutySurvey">
        <dc:Bounds x="850" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Csat" bpmnElement="Task_Csat">
        <dc:Bounds x="850" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_CsatTimeout" bpmnElement="Boundary_CsatTimeout">
        <dc:Bounds x="912" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="945" y="250" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Digest" bpmnElement="Task_Digest">
        <dc:Bounds x="1020" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CsatDone" bpmnElement="Gateway_CsatDone" isMarkerVisible="true">
        <dc:Bounds x="1045" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1030" y="138" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join">
        <dc:Bounds x="1145" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseCase" bpmnElement="Task_CloseCase">
        <dc:Bounds x="1240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PostWebhook" bpmnElement="Task_PostWebhook">
        <dc:Bounds x="1390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Closed" bpmnElement="End_Closed">
        <dc:Bounds x="1542" y="182" width="36" height="36" />
